# Public build-time path; rebuild the static bundle after changing this.
VITE_BASE_PATH=/
# Vite dev and production-preview ports; Vite loads these from .env.
DEV_PORT=5173
PREVIEW_PORT=4173
# Export these in the shell for Playwright (it does not load .env).
PLAYWRIGHT_PORT=4173
# Must point to the production preview above; change both together.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173
# No secrets, remote API, payment service or persistence are used.
